<?xml version="1.0" encoding="utf-8"?>
<extension>
    
    <source path="src" />
    
    <section if="ios">
        
        <dependency name="UIKit.framework" />
        <dependency name="ReplayKit.framework" />
        <dependency name="QuartzCore.framework" />
        <dependency name="OpenGLES.framework" />
    
        <ios linker-flags="-weak_framework ReplayKit" />
    
    </section>
    
    <section if="android">
        <dependency name="screencapture" path="dependencies/screencapture" />
        
        <android extension="com.byrobin.screencapture.ScreenCaptureEX" />
    </section>

</extension>